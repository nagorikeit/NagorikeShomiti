  "protocol_handlers": [
    {
      "protocol": "web+somiti",
      "url": "/?action=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
